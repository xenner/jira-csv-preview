{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.3",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.atlassian.net/*",
    "*://*.atlassian.com/*",
    "*://*.jira.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "options/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/*",
        "*://*.atlassian.com/*",
        "*://*.jira.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "src/viewer.js",
        "src/viewer.css",
        "vendor/papaparse.min.js"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "commands": {
    "open-csv-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "__MSG_commandOpenPanel__"
    }
  }
}
